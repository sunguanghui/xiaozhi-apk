<?xml version="1.0" encoding="utf-8"?>
<!--
    极小屏默认布局（sw < 320dp，适配小天才等儿童手表）
    手机端（sw >= 320dp）使用 layout-sw320dp/activity_main.xml
    保留核心 View ID 与 MainActivity 一致；移除 AppBar、消息卡片、操作引导
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <!-- 连接状态行（顶部居中） -->
    <LinearLayout
        android:id="@+id/statusRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/statusDot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_status_dot"
            android:backgroundTint="@color/status_disconnected" />

        <TextView
            android:id="@+id/connectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_disconnected"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 连接按钮（右上角，text-only 极小） -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/connectButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:text="@string/connect"
        android:textSize="11sp"
        android:minHeight="36dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:icon="@drawable/ic_link"
        app:iconSize="14dp"
        app:iconGravity="start"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 通话中状态文字（大按钮上方，默认隐藏） -->
    <TextView
        android:id="@+id/callStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/calling"
        android:textSize="12sp"
        android:textColor="@color/primary"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/voiceButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 大圆形通话按钮（屏幕中心，放大至 150dp 方便盲按） -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/voiceButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="开始聊天"
        app:fabSize="auto"
        app:fabCustomSize="150dp"
        app:maxImageSize="64dp"
        app:srcCompat="@drawable/ic_mic"
        app:tint="@android:color/white"
        app:elevation="6dp"
        app:backgroundTint="@color/primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 按钮下方提示文字 -->
    <TextView
        android:id="@+id/voiceHintText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="点击开始聊天"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        app:layout_constraintTop_toBottomOf="@+id/voiceButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>