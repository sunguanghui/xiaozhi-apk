<?xml version="1.0" encoding="utf-8"?>
<!--
    小智AI助手 应用图标前景
    设计语言：声波均衡器（5根圆角柱，中间高两侧低）+ AI光点（右上角4芒星）
    内容位于 adaptive icon 安全区域（108×108 中央 72×72 圆形内）
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ── 声波均衡器：5根圆角矩形柱，白色 ──────────────────────────── -->
    <!-- 整体居中：x 跨度 29~79，y 跨度 37~71，中心(54,54) -->

    <!-- 柱1（最矮，左） -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 32,47
            A 3,3 0 0 1 35,50
            L 35,58
            A 3,3 0 0 1 32,61
            A 3,3 0 0 1 29,58
            L 29,50
            A 3,3 0 0 1 32,47 Z" />

    <!-- 柱2（次矮） -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 43,43
            A 3,3 0 0 1 46,46
            L 46,62
            A 3,3 0 0 1 43,65
            A 3,3 0 0 1 40,62
            L 40,46
            A 3,3 0 0 1 43,43 Z" />

    <!-- 柱3（最高，中央） -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 54,37
            A 3,3 0 0 1 57,40
            L 57,68
            A 3,3 0 0 1 54,71
            A 3,3 0 0 1 51,68
            L 51,40
            A 3,3 0 0 1 54,37 Z" />

    <!-- 柱4（次矮） -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 65,43
            A 3,3 0 0 1 68,46
            L 68,62
            A 3,3 0 0 1 65,65
            A 3,3 0 0 1 62,62
            L 62,46
            A 3,3 0 0 1 65,43 Z" />

    <!-- 柱5（最矮，右） -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 76,47
            A 3,3 0 0 1 79,50
            L 79,58
            A 3,3 0 0 1 76,61
            A 3,3 0 0 1 73,58
            L 73,50
            A 3,3 0 0 1 76,47 Z" />

    <!-- ── AI 光点：右上角 4 芒星（表示智能/AI）─────────────────────── -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.9"
        android:pathData="M 78,24
            L 79.2,27.2
            L 82,28
            L 79.2,28.8
            L 78,32
            L 76.8,28.8
            L 74,28
            L 76.8,27.2 Z" />

    <!-- 小圆点（辅助光晕） -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.5"
        android:pathData="M 84,33
            A 1.5,1.5 0 1 1 84,36
            A 1.5,1.5 0 1 1 84,33 Z" />

</vector>
