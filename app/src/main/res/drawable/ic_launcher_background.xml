<?xml version="1.0" encoding="utf-8"?>
<!--
    小智AI助手 应用图标背景
    从左上角深蓝渐变到右下角亮蓝，与品牌主色 #1D7FFF 保持一致
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 渐变底色：左上深蓝 → 右下亮蓝 -->
    <path
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor"
            xmlns:aapt="http://schemas.android.com/aapt">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#1565C0" />
                <item android:offset="1" android:color="#1D7FFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 左上角柔和高光圆，增加层次感 -->
    <path
        android:pathData="M0,0 A 60,60 0 0 1 60,0 Z"
        android:fillColor="#20FFFFFF" />

</vector>
