<?xml version="1.0" encoding="utf-8"?><!--
   Android 12 以下的自动备份规则（fullBackupContent）。
   xiaozhi_settings.xml 里保存了明文 WebSocket token / 设备 MAC，
   不允许随云备份或换机迁移带走。
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="sharedpref" path="xiaozhi_settings.xml" />
</full-backup-content>
