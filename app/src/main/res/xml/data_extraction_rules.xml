<?xml version="1.0" encoding="utf-8"?><!--
   Android 12+ 的备份 / 换机迁移规则。
   xiaozhi_settings.xml 里保存了明文 WebSocket token / 设备 MAC，
   不允许随云备份或换机迁移带走。
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="xiaozhi_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="xiaozhi_settings.xml" />
    </device-transfer>
</data-extraction-rules>
